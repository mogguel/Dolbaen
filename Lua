local function MakeUmbrella(head)
    if head:FindFirstChild("FM_Umbrella") then head.FM_Umbrella:Destroy() end
    local m = Instance.new("Model")
    m.Name = "FM_Umbrella"
    m.Parent = head
    local handle = Instance.new("Part")
    handle.Size = Vector3.new(0.4, 6, 0.4)
    handle.Color = Color3.fromRGB(25, 25, 25)
    handle.Material = Enum.Material.SmoothPlastic
    handle.CanCollide = false
    handle.Massless = true
    handle.Parent = m
    local top = Instance.new("Part")
    top.Size = Vector3.new(14, 1.2, 14)
    top.Color = Color3.fromRGB(0, 255, 90)
    top.Material = Enum.Material.Neon
    top.CanCollide = false
    top.Massless = true
    top.Parent = m
    local mesh = Instance.new("SpecialMesh", top)
    mesh.MeshType = Enum.MeshType.Sphere
    mesh.Scale = Vector3.new(1, 0.22, 1)
    local w1 = Instance.new("Weld")
    w1.Part0 = head
    w1.Part1 = handle
    w1.C0 = CFrame.new(0, 6.5, 0)
    w1.Parent = handle
    local w2 = Instance.new("Weld")
    w2.Part0 = handle
    w2.Part1 = top
    w2.C0 = CFrame.new(0, 3.2, 0)
    w2.Parent = top
end

local function MakeTracer(a, b)
    local a0 = Instance.new("Attachment", a)
    local a1 = Instance.new("Attachment", b)
    local beam = Instance.new("Beam")
    beam.Attachment0 = a0
    beam.Attachment1 = a1
    beam.Width0 = 0.12
    beam.Width1 = 0.12
    beam.Color = ColorSequence.new(Color3.fromRGB(0, 255, 100))
    beam.FaceCamera = true
    beam.LightEmission = 1
    beam.Transparency = NumberSequence.new(0.1)
    beam.Parent = TracerFolder
    beam.Destroying:Connect(function() a0:Destroy() a1:Destroy() end)
end

local function bone(p0, p1)
    if not p0 or not p1 then return end
    local a0 = Instance.new("Attachment", p0)
    local a1 = Instance.new("Attachment", p1)
    local beam = Instance.new("Beam")
    beam.Attachment0 = a0
    beam.Attachment1 = a1
    beam.Width0 = 0.09
    beam.Width1 = 0.09
    beam.Color = ColorSequence.new(Color3.fromRGB(0, 255, 80))
    beam.FaceCamera = true
    beam.LightEmission = 1
    beam.Transparency = NumberSequence.new(0)
    beam.Parent = SkelFolder
    beam.Destroying:Connect(function() a0:Destroy() a1:Destroy() end)
end

local function MakeSkeleton(char)
    clearFolder(SkelFolder)
    local links = {
        {"Head","UpperTorso"},{"UpperTorso","LowerTorso"},
        {"UpperTorso","LeftUpperArm"},{"LeftUpperArm","LeftLowerArm"},{"LeftLowerArm","LeftHand"},
        {"UpperTorso","RightUpperArm"},{"RightUpperArm","RightLowerArm"},{"RightLowerArm","RightHand"},
        {"LowerTorso","LeftUpperLeg"},{"LeftUpperLeg","LeftLowerLeg"},{"LeftLowerLeg","LeftFoot"},
        {"LowerTorso","RightUpperLeg"},{"RightUpperLeg","RightLowerLeg"},{"RightLowerLeg","RightFoot"},
        {"Head","Torso"},{"Torso","Left Arm"},{"Torso","Right Arm"},{"Torso","Left Leg"},{"Torso","Right Leg"},
    }
    for _, L in ipairs(links) do
        bone(char:FindFirstChild(L[1]), char:FindFirstChild(L[2]))
    end
    if not char:FindFirstChild("FM_HL") then
        local hl = Instance.new("Highlight")
        hl.Name = "FM_HL"
        hl.FillColor = Color3.fromRGB(0, 255, 90)
        hl.OutlineColor = Color3.fromRGB(0, 255, 140)
        hl.FillTransparency = 0.7
        hl.OutlineTransparency = 0
        hl.Parent = char
    end
end

