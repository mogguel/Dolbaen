    local btn = Instance.new("TextButton", row)
    btn.Size = UDim2.new(0, 54, 0, 26)
    btn.Position = UDim2.new(1, -60, 0.5, -13)
    btn.BackgroundColor3 = default and Color3.fromRGB(255, 120, 40) or Color3.fromRGB(45, 25, 32)
    btn.Text = default and "ON" or "OFF"
    btn.TextColor3 = Color3.new(1,1,1)
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 12
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)

    local function set(v)
        S[key] = v
        btn.Text = v and "ON" or "OFF"
        TweenService:Create(btn, TweenInfo.new(0.12), {
            BackgroundColor3 = v and Color3.fromRGB(255, 120, 40) or Color3.fromRGB(45, 25, 32)
