pcall(function()
    local mt = getrawmetatable(Mouse) or getrawmetatable(game)
    local old = mt.__index
    setreadonly(mt, false)
    mt.__index = newcclosure(function(self, k)
        if S.SilentAim and silentPart and silentPart.Parent then
            if rawequal(self, Mouse) then
                if k == "Hit" then return silentPart.CFrame
                elseif k == "Target" then return silentPart
                elseif k == "UnitRay" then
                    local origin = Camera.CFrame.Position
                    local dir = (silentPart.Position - origin).Unit
                    return Ray.new(origin, dir * 1000)
                end
            end
        end
        return old(self, k)
    end)
    setreadonly(mt, true)
end)

RunService.RenderStepped:Connect(function()
    clearFolder(TracerFolder)
    if not S.Skeleton then
        clearFolder(SkelFolder)
        if Closest and Closest.Character and Closest.Character:FindFirstChild("FM_HL") then
            Closest.Character.FM_HL:Destroy()
        end
    end

    local enemy, dist = GetClosest()
    Closest = enemy

    if S.SilentAim and enemy and enemy.Character then
        silentPart = enemy.Character:FindFirstChild("Head") or enemy.Character:FindFirstChild("HumanoidRootPart")
    else
        silentPart = nil
    end

    if S.Aimbot and not Checking and enemy and enemy.Character then
        local part = enemy.Character:FindFirstChild("Head") or enemy.Character:FindFirstChild("HumanoidRootPart")
        if part then Camera.CFrame = CFrame.lookAt(Camera.CFrame.Position, part.Position) end
    end

    if S.AutoPlay and enemy and enemy.Character and not Checking then
        local part = enemy.Character:FindFirstChild("Head") or enemy.Character:FindFirstChild("HumanoidRootPart")
        if part then
            Camera.CFrame = CFrame.lookAt(Camera.CFrame.Position, part.Position)
            pcall(function()
                VirtualUser:Button1Down(Vector2.new(), Camera.CFrame)
                task.wait(0.05)
                VirtualUser:Button1Up(Vector2.new(), Camera.CFrame)
            end)
        end
    end

    if S.SafeMode and enemy and enemy.Character and enemy.Character:FindFirstChild("HumanoidRootPart") then
        if LP.Character and LP.Character:FindFirstChild("HumanoidRootPart") then
            local t = enemy.Character.HumanoidRootPart
            LP.Character.HumanoidRootPart.CFrame = CFrame.new(t.Position + Vector3.new(0, 25, 0))
        end
    end

    Alert.Visible = S.EnemyAlert and enemy ~= nil and dist <= 15

    if enemy and enemy.Character then
        local head = enemy.Character:FindFirstChild("Head")
        local hrp = enemy.Character:FindFirstChild("HumanoidRootPart")
        if S.Umbrella and head then
            if not head:FindFirstChild("FM_Umbrella") then MakeUmbrella(head) end
        elseif head and head:FindFirstChild("FM_Umbrella") then
            head.FM_Umbrella:Destroy()
        end
        if S.Tracers and hrp and LP.Character and LP.Character:FindFirstChild("HumanoidRootPart") then
            MakeTracer(LP.Character.HumanoidRootPart, hrp)
        end
        if S.Skeleton then MakeSkeleton(enemy.Character) end
        if S.HPBar then MakeHP(enemy.Character)
        elseif head and head:FindFirstChild("FM_HP") then head.FM_HP:Destroy() end
    end

    if S.SpeedEnabled and LP.Character and LP.Character:FindFirstChild("Humanoid") then
        LP.Character.Humanoid.WalkSpeed = S.Speed
    end

    if S.Fly and LP.Character and LP.Character:FindFirstChild("HumanoidRootPart") then
        local hrp = LP.Character.HumanoidRootPart
        if not flyBV or not flyBV.Parent then
            flyBV = Instance.new("BodyVelocity")
            flyBV.MaxForce = Vector3.new(1e9, 1e9, 1e9)
            flyBV.Parent = hrp
        end
        local dir = Vector3.zero
        if UIS:IsKeyDown(Enum.KeyCode.W) then dir = dir + Camera.CFrame.LookVector end
        if UIS:IsKeyDown(Enum.KeyCode.S) then dir = dir - Camera.CFrame.LookVector end
        if UIS:IsKeyDown(Enum.KeyCode.A) then dir = dir - Camera.CFrame.RightVector end
        if UIS:IsKeyDown(Enum.KeyCode.D) then dir = dir + Camera.CFrame.RightVector end
        if UIS:IsKeyDown(Enum.KeyCode.Space) then dir = dir + Vector3.yAxis end
        if UIS:IsKeyDown(Enum.KeyCode.LeftControl) then dir = dir - Vector3.yAxis end
        flyBV.Velocity = dir.Magnitude > 0 and dir.Unit * S.FlySpeed or Vector3.zero
    elseif flyBV then
        flyBV:Destroy()
        flyBV = nil
    end
end)

